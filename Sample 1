import os
import json
from pathlib import Path
import cv2

class AthleteVideoDataset:
    def __init__(self, root_dir: str):
        self.root_dir = Path(root_dir)
        self.metadata = []
    
    def process_videos(self):
        for video_file in self.root_dir.glob("**/*.mp4"):
            cap = cv2.VideoCapture(str(video_file))
            fps = cap.get(cv2.CAP_PROP_FPS)
            frame_count = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
            
            metadata = {
                "filename": video_file.name,
                "duration_seconds": frame_count / fps,
                "fps": fps,
                "resolution": f"{int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))}x{int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))}",
                "sport": "baseball",
                "tags": ["pitching", "training"],
                "recorded_date": "2025-01-01"
            }
            self.metadata.append(metadata)
            cap.release()
        
        with open(self.root_dir / "metadata.json", "w") as f:
            json.dump(self.metadata, f, indent=2)
        
        print(f"✅ Processed {len(self.metadata)} videos. Metadata saved.")

if __name__ == "__main__":
    processor = AthleteVideoDataset("athlete_videos")
    processor.process_videos()
